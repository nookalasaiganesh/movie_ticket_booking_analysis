Payment [shape=box, style="filled", fillcolor="#acd4ff", color="#164e91", penwidth=1.7, fontsize=12, fontname="Arial Bold", label="PAYMENT"];
Payment_a0 [shape=ellipse, style="filled", fillcolor="#e5f2ff", label=<<U>payment_id (PK)</U>>, fontsize=8, margin="0.07,0.04"];
Payment -- Payment_a0 [color="#64748b", penwidth=0.8];
