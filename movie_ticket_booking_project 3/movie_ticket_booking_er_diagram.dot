R0 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Has", fontsize=9, width=1.0, height=0.55];
Movies -- R0 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R0 -- Shows [label="N", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R1 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Contains", fontsize=9, width=1.0, height=0.55];
Theatres -- R1 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R1 -- Screens [label="N", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R2 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Has", fontsize=9, width=1.0, height=0.55];
Screens -- R2 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R2 -- Seats [label="N", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R3 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Hosts", fontsize=9, width=1.0, height=0.55];
Screens -- R3 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R3 -- Shows [label="N", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R4 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Receives", fontsize=9, width=1.0, height=0.55];
Shows -- R4 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R4 -- Bookings [label="N", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R5 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Selected for", fontsize=9, width=1.0, height=0.55];
Seats -- R5 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R5 -- Bookings [label="N", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R6 [shape=diamond, style="filled", fillcolor="#ffe5a3", color="#a56a00", label="Paid By", fontsize=9, width=1.0, height=0.55];
Bookings -- R6 [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
R6 -- Payment [label="1", fontsize=10, fontcolor="#d11f26", penwidth=1.3];
{rank=same; Movies; Theatres;}
{rank=same; Shows; Screens; Seats;}
{rank=same; Bookings; Payment;}
subgraph cluster_legend { label="LEGEND"; fontsize=11; color="#8b8b8b"; style="rounded"; bgcolor="#fff8df";
legendStrong [shape=box, style=filled, fillcolor="#acd4ff", label="Strong entity"];
legendWeak [shape=box, peripheries=2, style=filled, fillcolor="#acd4ff", label="Weak entity symbol"];
legendRel [shape=diamond, style=filled, fillcolor="#ffe5a3", label="Relationship"];
legendAttr [shape=ellipse, style=filled, fillcolor="#e5f2ff", label="Attribute"];
legendKeys [shape=note, style=filled, fillcolor="white", label="PK = Primary Key\nFK = Foreign Key\n1 = One, N = Many"];
legendStrong -- legendWeak -- legendRel -- legendAttr -- legendKeys [style=invis]; }
}