graph ER {
graph [rankdir=LR, splines=polyline, overlap=false, nodesep=0.28, ranksep=0.7, pad=0.25, bgcolor="white", labelloc=t, label="MOVIE TICKET BOOKING & REVENUE ANALYSIS\nEntity-Relationship (ER) Diagram", fontsize=24, fontname="Arial", fontcolor="#10245b", size="18,10!", ratio=fill];
node [fontname="Arial", fontsize=9, color="#174a7e", penwidth=1.3]; edge [fontname="Arial", fontsize=9, color="#374151", penwidth=1.1];
Movies [shape=box, style="filled", fillcolor="#acd4ff", color="#164e91", penwidth=1.7, fontsize=12, fontname="Arial Bold", label="MOVIES"];
Movies_a0 [shape=ellipse, style="filled", fillcolor="#e5f2ff", label=<<U>movie_id (PK)</U>>, fontsize=8, margin="0.07,0.04"];
Movies -- Movies_a0 [color="#64748b", penwidth=0.8];
Movies_a1 [shape=ellipse, style="filled", fillcolor="#e5f2ff", label=<movie_title>, fontsize=8, margin="0.07,0.04"];
Movies -- Movies_a1 [color="#64748b", penwidth=0.8];
